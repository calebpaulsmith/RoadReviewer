import pandas as pd
import json

df = _sqldf
pdf = df.toPandas()

features = []
for row in pdf.itertuples(index=False):
    # Skip rows without coordinates
    if row.extracted_lat is None or row.extracted_lon is None:
        continue

    attributes = {
        "Applicant_project_id": row.Applicant_project_id,
        "WorkCategory": row.WorkCategory,
        "Project": row.Project,
        "DI": row.DI,
        "County_Name": row.County_Name,
        "Applicant_Name": row.Applicant_Name,
        "Extracted_lat": row.extracted_lat,
        "Extracted_lon": row.extracted_lon,
        "DI_Description": row.DI_Description,
        "LocationGroupLineItem": row.LocationGroupLineItem,
        "location_grouping": row.location_grouping,
    }

    geometry = {
        "x": float(row.extracted_lon),
        "y": float(row.extracted_lat),
        "spatialReference": {"wkid": 4326}  # WGS 84
    }

    features.append({
        "attributes": attributes,
        "geometry": geometry
    })

adds_json = json.dumps(features)
print(f"{len(features)} features built")

